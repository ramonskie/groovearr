{
  "soulseek": {
    "slskd_url": "http://localhost:5030",
    "api_key": "your-slskd-api-key",
    "search_timeout": 60,
    "min_upload_speed": 0
  },
  "deezer": {
    "arl": "your-deezer-arl-token",
    "quality": "flac",
    "allow_fallback": true,
    "access_token": ""
  },
  "spotify": {
    "mode": "free",
    "client_id": "",
    "client_secret": "",
    "redirect_uri": "http://localhost:8008/api/spotify/callback",
    "tokens": {
      "access_token": "",
      "refresh_token": "",
      "expires_at": 0
    }
  },
  "library": {
    "download_path": "./downloads",
    "library_path": "./music",
    "folder_template": "{artist}/{album} ({year})/{track:02d} - {title}",
    "playlist_path": "./playlists",
    "playlist_template": "{position:02d} {artist} - {title}"
  },
  "quality": {
    "preferred_format": "flac",
    "min_bitrate": 0
  }
}
